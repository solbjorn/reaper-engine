#include "common.h"

//////////////////////////////////////////////////////////////////////////////////////////
uniform float4x4 m_texgen;

//////////////////////////////////////////////////////////////////////////////////////////
// Vertex
v2p_volume main(float4 P : POSITION)
{
    v2p_volume O;
    O.hpos = mul(P, m_WVP);
    O.tc = mul(P, m_texgen);
    return O;
}
FXVS;
