  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <NMakeOutput>$(SolutionDir)\3rd_party\_LIB\$(Configuration)\$(PlatformShortName)\crypto.lib</NMakeOutput>
    <NMakeBuildCommandLine>
      set "PATH=%VSAPPIDDIR%\CommonExtensions\Microsoft\CMake\CMake\bin;%VSAPPIDDIR%\CommonExtensions\Microsoft\CMake\Ninja;%VSAPPIDDIR%CommonExtensions\Microsoft\TeamFoundation\Team Explorer\Git\mingw64\bin;$(SolutionDir)\3rd_party\Src\crypto\bin;%PATH%"
      set "LIBC_OPTIONS=$(libcOptions)"
      set "LIBCXX_OPTIONS=$(libcxxOptions)"
      set "LIBCXX_PATH=$(libcxxPath)"
      md _Build
      cd _Build
      echo * > .gitignore
      cmake -G Ninja -DCMAKE_BUILD_TYPE=$(Configuration) -DCMAKE_INSTALL_PREFIX="$(Configuration)\$(PlatformShortName)" -DCMAKE_TOOLCHAIN_FILE="$(SolutionDir)\3rd_party\Src\3rd_party_toolchain.cmake" -DCMAKE_PROJECT_INCLUDE="$(SolutionDir)\3rd_party\Src\3rd_party_properties.cmake" -DBUILD_TESTING=OFF ..\boringssl
      cmake --build . --config $(Configuration)
      cmake --install . --config $(Configuration)
      md "$(Configuration)\$(PlatformShortName)\lib\pkgconfig"
      call powershell -Command "(gc ..\lib\libcrypto.pc.in) -replace '@CMAKE_INSTALL_PREFIX@', '$(SolutionDir)3rd_party\Src\crypto\_Build\$(Configuration)\$(PlatformShortName)' -replace '\\', '/' | Out-File -encoding ASCII $(Configuration)\$(PlatformShortName)\lib\pkgconfig\libcrypto.pc"
      call powershell -Command "(gc ..\lib\libssl.pc.in) -replace '@CMAKE_INSTALL_PREFIX@', '$(SolutionDir)3rd_party\Src\crypto\_Build\$(Configuration)\$(PlatformShortName)' -replace '\\', '/' | Out-File -encoding ASCII $(Configuration)\$(PlatformShortName)\lib\pkgconfig\libssl.pc"
      copy /Y "$(Configuration)\$(PlatformShortName)\lib\crypto.lib" "$(SolutionDir)\3rd_party\_LIB\$(Configuration)\$(PlatformShortName)\crypto.lib"
      copy /Y "decrepit.lib" "$(SolutionDir)\3rd_party\_LIB\$(Configuration)\$(PlatformShortName)\decrepit.lib"
    </NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>
      RD /S/Q _Build
      $(NMakeBuildCommandLine)
    </NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>RD /S/Q _Build</NMakeCleanCommandLine>
